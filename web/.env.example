# well-cinebox web/ — environment variables.
# Copy to .env.local for local development. Never commit real secrets.

# Public base URL of the deployment (used for metadata links).
NEXT_PUBLIC_SITE_URL=

# HMAC-SHA256 key used to sign /api/stream and /api/subtitle tokens.
# REQUIRED in production: /api/stream returns HTTP 500 until this is set.
# Generate with: openssl rand -hex 32   (leave empty here — no real value)
STREAM_SIGNING_SECRET=

# Stream/subtitle token lifetime in seconds (default 21600 = 6h).
# Tokens are additionally clamped to the upstream signed-cookie expiry.
STREAM_TOKEN_TTL_SEC=21600

# HTTP(S) egress proxy for ALL MovieBox provider + CDN fetches.
# The provider blocks datacenter IPs, so without a residential/mobile exit
# the app falls back to the bundled offline demo catalog.
# Example: MOVIEBOX_PROXY_URL=http://user:pass@proxy-host:8080
MOVIEBOX_PROXY_URL=

# Provider tab rendered on the home page (upstream TUI hardcodes 2).
MOVIEBOX_HOME_TAB=2

# Per-request timeout (ms) for provider API calls.
MOVIEBOX_TIMEOUT_MS=12000

# In-memory catalog cache TTL (ms) for home rails.
CONTENT_CACHE_TTL_MS=300000

# Force the bundled offline demo catalog even if the provider is reachable.
DEMO_MODE=false
